 #define TOUCH_MAX        10u
 #define TOUCH_GOODIX     1
 #define TOUCH_FTS        2
+#define TOUCH_SW42000    3
+#define V50_SE_PA        0x00c80000u
+#define V50_TLMM_PA      0x03000000u
 /* GT9896 is Yellowstone in Xiaomi sweet-r-oss, not the Berlin protocol. */
 #define GOODIX_PID_REG   0x4022u
 #define GOODIX_EVENT_REG 0x4180u
@@ -545,6 +548,32 @@ touch_se_init(void)
 	return true;
 }
 
+/* Silicon Works SW42000 parser for LG V50 (I2C 0x28, reg 0x0200) */
+static int
+touch_sw42000(void)
+{
+	uint8_t buf[112] = {0};
+	int err = touch_read(0x28, 0x0200, true, buf, sizeof(buf));
+	if (err) {
+		return err;
+	}
+	unsigned cnt = buf[8] & 0x1fu;
+	uint32_t mask = 0;
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	for (unsigned i = 0; i < cnt && i < TOUCH_MAX; ++i) {
+		const uint8_t *p = buf + 12 + i * 10;
+		unsigned event = p[0] & 0x0fu;
+		unsigned id = p[1];
+		if (id < TOUCH_MAX && (event == 1 || event == 2)) {
+			mask |= (1u << id);
+			x[id] = (int)p[2] | ((int)p[3] << 8);
+			y[id] = (int)p[4] | ((int)p[5] << 8);
+		}
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
