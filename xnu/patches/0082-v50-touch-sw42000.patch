+		printf("SWEET TOUCH: detected SM8150 QUP SE17 at 0x%08x; using LG V50 touch\n", V50_SE_PA);
+		st.se = v50_se;
+		st.gpio = v50_gpio;
+	}
 	if (!st.gcc || !st.gpio || !st.se) {
 		printf("SWEET TOUCH: MMIO mapping failed\n");
