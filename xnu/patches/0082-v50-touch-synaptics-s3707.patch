diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 03defe6..cdde1ac 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -545,19 +545,214 @@ touch_se_init(void)
 	return true;
 }
 
+#define V50_TLMM_PA      0x03d00000u
+#define V50_GCC_PA       0x00100000u
+#define V50_SDA_PIN      55
+#define V50_SCL_PIN      56
+#define V50_RESET_PIN    54
+#define V50_IRQ_PIN      122
+#define V50_VCL_PIN      59
+#define V50_VDD_PIN      152
+
+static inline void
+v50_bb_set(unsigned pin, int release)
+{
+	uint32_t o = pin * 0x1000u;
+	uint32_t cfg = touch_rd(st.gpio, o) & ~0x3ffu;
+	touch_wr(st.gpio, o + 4, touch_rd(st.gpio, o + 4) & ~2u);
+	touch_wr(st.gpio, o, cfg | 3u | (release ? 0 : 0x200u));
+	delay(5);
+}
+
+static inline int
+v50_bb_get(unsigned pin)
+{
+	uint32_t o = pin * 0x1000u;
+	return (touch_rd(st.gpio, o + 4) & 1u);
+}
+
+static int
+v50_bb_high(void)
+{
+	v50_bb_set(V50_SCL_PIN, 1);
+	for (unsigned i = 0; i < 1000; i++) {
+		if (v50_bb_get(V50_SCL_PIN)) {
+			delay(5);
+			return 0;
+		}
+		delay(10);
+	}
+	return -1;
+}
+
+static int
+v50_bb_start(int repeat)
+{
+	v50_bb_set(V50_SDA_PIN, 1);
+	if (v50_bb_high() != 0) return -1;
+	if (!v50_bb_get(V50_SDA_PIN)) return repeat ? -2 : -3;
+	v50_bb_set(V50_SDA_PIN, 0);
+	v50_bb_set(V50_SCL_PIN, 0);
+	return 0;
+}
+
+static int
+v50_bb_stop(void)
+{
+	v50_bb_set(V50_SDA_PIN, 0);
+	if (v50_bb_high() != 0) {
+		v50_bb_set(V50_SDA_PIN, 1);
+		v50_bb_set(V50_SCL_PIN, 1);
+		return -1;
+	}
+	v50_bb_set(V50_SDA_PIN, 1);
+	return v50_bb_get(V50_SDA_PIN) ? 0 : -1;
+}
+
+static int
+v50_bb_write(uint8_t val)
+{
+	for (unsigned i = 0; i < 8; i++) {
+		int bit = (val >> (7 - i)) & 1;
+		v50_bb_set(V50_SDA_PIN, bit);
+		if (v50_bb_high() != 0) return -1;
+		v50_bb_set(V50_SCL_PIN, 0);
+	}
+	v50_bb_set(V50_SDA_PIN, 1);
+	if (v50_bb_high() != 0) return -1;
+	int ack = !v50_bb_get(V50_SDA_PIN);
+	v50_bb_set(V50_SCL_PIN, 0);
+	return ack ? 0 : -2;
+}
+
+static int
+v50_bb_read(uint8_t *val, int last)
+{
+	unsigned v = 0;
+	v50_bb_set(V50_SDA_PIN, 1);
+	for (unsigned i = 0; i < 8; i++) {
+		if (v50_bb_high() != 0) return -1;
+		v = (v << 1) | (unsigned)v50_bb_get(V50_SDA_PIN);
+		v50_bb_set(V50_SCL_PIN, 0);
+	}
+	v50_bb_set(V50_SDA_PIN, last ? 1 : 0);
+	if (v50_bb_high() != 0) return -1;
+	v50_bb_set(V50_SCL_PIN, 0);
+	v50_bb_set(V50_SDA_PIN, 1);
+	*val = (uint8_t)v;
+	return 0;
+}
+
+static int
+v50_sw_xfer(uint8_t slv, const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr)
+{
+	int e = v50_bb_start(0);
+	if (e) {
+		v50_bb_set(V50_SDA_PIN, 1); v50_bb_set(V50_SCL_PIN, 1);
+		return e;
+	}
+	e = v50_bb_write((uint8_t)(slv << 1));
+	if (e) goto fail;
+	for (unsigned i = 0; i < nt; i++) {
+		e = v50_bb_write(tx[i]);
+		if (e) goto fail;
+	}
+	if (nr) {
+		e = v50_bb_start(1);
+		if (e) goto fail;
+		e = v50_bb_write((uint8_t)((slv << 1) | 1));
+		if (e) goto fail;
+		for (unsigned i = 0; i < nr; i++) {
+			e = v50_bb_read(&rx[i], (i + 1 == nr) ? 1 : 0);
+			if (e) goto fail;
+		}
+	}
+	e = v50_bb_stop();
+	v50_bb_set(V50_SDA_PIN, 1); v50_bb_set(V50_SCL_PIN, 1);
+	return e;
+fail:
+	v50_bb_stop();
+	v50_bb_set(V50_SDA_PIN, 1); v50_bb_set(V50_SCL_PIN, 1);
+	return e;
+}
+
+static int
+v50_sw_regread(unsigned reg, uint8_t *buf, unsigned n)
+{
+	uint8_t ptr[2] = {
+		(uint8_t)((n > 4 ? 0x20 : 0) | ((reg >> 8) & 15)),
+		(uint8_t)reg
+	};
+	return v50_sw_xfer(0x28, ptr, 2, buf, n);
+}
+
+static int
+v50_sw_regwrite(unsigned reg, uint32_t val)
+{
+	uint8_t b[6] = {
+		(uint8_t)(0x40 | ((reg >> 8) & 15)),
+		(uint8_t)reg,
+		(uint8_t)val,
+		(uint8_t)(val >> 8),
+		(uint8_t)(val >> 16),
+		(uint8_t)(val >> 24)
+	};
+	return v50_sw_xfer(0x28, b, 6, NULL, 0);
+}
+
+static inline uint32_t
+v50_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static inline unsigned
+v50_report_extra(const uint8_t *b)
+{
+	uint32_t h = v50_le32(b + 8);
+	unsigned n = (h >> 8) & 31;
+	if ((h & 255) != 0 || n <= 1 || n > 10) return 0;
+	return (((v50_le32(b + 4) >> 16) & 15) == 5) ? 12 * (n - 1) : 108;
+}
+
+static int
+v50_decode(const uint8_t *b, unsigned len, uint32_t *out_mask, int *out_x, int *out_y)
+{
+	if (len < 36) return -1;
+	uint32_t h = v50_le32(b + 8);
+	if ((h & 255) != 0) return 1;
+	unsigned n = (h >> 8) & 31;
+	if (n > 10 || len < 36 + 12 * n) return -1;
+	*out_mask = 0;
+	uint32_t seen = 0;
+	if (h >> 31) return 0;
+	for (unsigned i = 0; i < n; i++) {
+		const uint8_t *p = b + 36 + i * 12;
+		uint32_t a = v50_le32(p), c = v50_le32(p + 4);
+		unsigned id = a & 31, ev = (a >> 16) & 3, x = a >> 18, y = c & 0x3fff;
+		if (id == 15) { *out_mask = 0; return 0; }
+		if (id >= 10 || (seen & (1u << id))) return -1;
+		seen |= (1u << id);
+		if (ev == 0 || ev == 3) continue;
+		*out_mask |= (1u << id);
+		out_x[id] = (int)(x > 1439 ? 1439 : x);
+		out_y[id] = (int)(y > 3119 ? 3119 : y);
+	}
+	return 0;
+}
+
 static void
 touch_thread(void *arg, wait_result_t result)
 {
-	unsigned delay_s = 45;
+	unsigned delay_s = 1;
 	(void)arg;
 	(void)result;
-	/*
-	 * Start late (boot-arg sweettouchdelay, seconds): if the bus access
-	 * below hangs the SoC, the persistent log and the GUI got there first.
-	 */
 	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
 	printf("SWEET TOUCH: starting in %u s\n", delay_s);
-	touch_wait(delay_s * 1000u);
+	if (delay_s) {
+		touch_wait(delay_s * 1000u);
+	}
+
+	vm_offset_t v50_tlmm = ml_io_map(V50_TLMM_PA, 0x100000);
+	if (v50_tlmm) {
+		printf("SWEET TOUCH: LG V50 SW42000 GPIO-I2C driver at TLMM SOUTH 0x%08x\n", V50_TLMM_PA);
+		st.gpio = v50_tlmm;
+
+		/* Vote GCC clocks for Wrapper 1 AHB & QUP17 SE */
+		vm_offset_t gcc = ml_io_map(V50_GCC_PA, 0x60000);
+		if (gcc) {
+			touch_wr(gcc, 0x5200c, touch_rd(gcc, 0x5200c) | (1u << 20) | (1u << 21) | (1u << 27));
+			touch_wr(gcc, 0x18734, touch_rd(gcc, 0x18734) | 1u);
+			printf("SWEET TOUCH: GCC 0x5200c=%#x 0x18734=%#x\n",
+			    touch_rd(gcc, 0x5200c), touch_rd(gcc, 0x18734));
+		}
+
+		/* Power pins: VCL (3.3V) and VDD (1.8V) enable */
+		touch_gpio(V50_VCL_PIN, 0, 3, 2, true);
+		touch_gpio(V50_VDD_PIN, 0, 3, 2, true);
+		touch_wait(20);
+
+		/* Reset sequence: pulse LOW on GPIO 54 */
+		printf("SWEET TOUCH: pulsing HW reset on GPIO %u\n", V50_RESET_PIN);
+		touch_gpio(V50_RESET_PIN, 0, 0, 2, true);
+		touch_wr(st.gpio, V50_RESET_PIN * 0x1000u + 4, touch_rd(st.gpio, V50_RESET_PIN * 0x1000u + 4) & ~2u);
+		touch_wait(30);
+		touch_wr(st.gpio, V50_RESET_PIN * 0x1000u + 4, touch_rd(st.gpio, V50_RESET_PIN * 0x1000u + 4) | 2u);
+		touch_wait(120);
+
+		/* IRQ pin: GPIO 122 input with pull-up */
+		touch_gpio(V50_IRQ_PIN, 0, 3, 2, false);
+
+		/* Configure SDA (GPIO 55) & SCL (GPIO 56) to high-Z release */
+		v50_bb_set(V50_SDA_PIN, 1);
+		v50_bb_set(V50_SCL_PIN, 1);
+		touch_wait(20);
+
+		/* Scan I2C bus (0x08 to 0x77) */
+		printf("SWEET TOUCH: scanning I2C bus on GPIO %u/%u...\n", V50_SDA_PIN, V50_SCL_PIN);
+		int found_slaves = 0;
+		for (unsigned a = 0x08; a <= 0x77; a++) {
+			if (v50_bb_start(0) == 0) {
+				if (v50_bb_write((uint8_t)(a << 1)) == 0) {
+					printf("SWEET TOUCH: FOUND I2C SLAVE AT 0x%02x!\n", a);
+					found_slaves++;
+				}
+				v50_bb_stop();
+			}
+		}
+		printf("SWEET TOUCH: scan complete, %d devices found\n", found_slaves);
+
+		/* Probe SW42000 at address 0x28, register 0x642 */
+		uint8_t version[4] = {0};
+		int pe = v50_sw_regread(0x642, version, 4);
+		printf("SWEET TOUCH: probe 0x28 rc=%d ver=0x%08x\n", pe, v50_le32(version));
+
+		/* Initialize SW42000 operating registers */
+		v50_sw_regwrite(0xfe4, 0);
+		v50_sw_regwrite(0xc00, 1);
+		v50_sw_regwrite(0xc01, 1);
+		v50_sw_regwrite(0xc03, 4);
+		touch_wait(30);
+		v50_sw_regwrite(0xc03, 0x8303);
+		touch_wait(50);
+
+		printf("SWEET TOUCH: SW42000 event loop running (SDA=%u SCL=%u IRQ=%u)\n",
+		    V50_SDA_PIN, V50_SCL_PIN, V50_IRQ_PIN);
+
+		uint32_t last_mask = 0;
+		unsigned loop_cnt = 0;
+		while (1) {
+			uint32_t o122 = V50_IRQ_PIN * 0x1000u;
+			int irq_low = !(touch_rd(st.gpio, o122 + 4) & 1u);
+			loop_cnt++;
+			if (irq_low || (last_mask != 0) || (loop_cnt % 10 == 0)) {
+				uint8_t b[156] = {0};
+				unsigned rlen = 48;
+				int e = v50_sw_regread(0x600, b, rlen);
+				if (!e) {
+					unsigned extra = v50_report_extra(b);
+					if (extra && extra <= 108) {
+						(void)v50_sw_regread(0x60c, b + 48, extra);
+						rlen += extra;
+					}
+					uint32_t mask = 0;
+					int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+					int d = v50_decode(b, rlen, &mask, x, y);
+					if (d == 0) {
+						if (mask != last_mask) {
+							printf("SWEET TOUCH: mask=0x%x x0=%d y0=%d irq=%d\n", mask, x[0], y[0], irq_low);
+							last_mask = mask;
+						}
+						touch_report(mask, x, y);
+					}
+				}
+			}
+			touch_wait(5);
+		}
+		touch_report(0, st.x, st.y);
+		goto out;
+	}
+
 	printf("SWEET TOUCH: mapping GCC/TLMM/SE7\n");
 	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
 	st.gpio = ml_io_map(TOUCH_NORTH_PA, 0x5b000);
