diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 03defe6..cdde1ac 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -214,7 +214,7 @@ static int
 touch_msg_run(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
     unsigned nr, bool stretch)
 {
-	if (st.dead || nt > 3 || nr > 90 || (nt && nr) || (!nt && !nr)) {
+	if (st.dead || nt > 3 || nr > 256 || (nt && nr) || (!nt && !nr)) {
 		return EIO;
 	}
 	if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
@@ -304,6 +304,13 @@ touch_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
 	return err;
 }
 
+static int
+touch_write(uint8_t addr, uint8_t reg, uint8_t val)
+{
+	uint8_t pkt[2] = { reg, val };
+	return touch_msg(addr, pkt, 2, NULL, 0, false);
+}
+
 static int
 touch_read(uint8_t addr, uint16_t reg, bool wide, uint8_t *buf, unsigned len)
 {
@@ -545,19 +552,157 @@ touch_se_init(void)
 	return true;
 }
 
+#pragma pack(1)
+struct s3707_touch_data {
+	uint8_t type;
+	uint8_t x_lsb;
+	uint8_t x_msb;
+	uint8_t y_lsb;
+	uint8_t y_msb;
+	uint8_t z;
+	uint8_t wx;
+	uint8_t wy;
+};
+
+struct rmi_pdt_desc {
+	uint8_t query_base;
+	uint8_t cmd_base;
+	uint8_t ctrl_base;
+	uint8_t data_base;
+	uint8_t int_src;
+	uint8_t fn_num;
+};
+#pragma pack()
+
+#define V50_SE_PA        0x00c80000u
+#define V50_TLMM_PA      0x03d00000u  /* TLMM SOUTH tile on SM8150 (pins 54, 55, 56, 59, 122, 152) */
+
 static void
 touch_thread(void *arg, wait_result_t result)
 {
-	unsigned delay_s = 45;
+	unsigned delay_s = 2;
 	(void)arg;
 	(void)result;
-	/*
-	 * Start late (boot-arg sweettouchdelay, seconds): if the bus access
-	 * below hangs the SoC, the persistent log and the GUI got there first.
-	 */
 	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
 	printf("SWEET TOUCH: starting in %u s\n", delay_s);
-	touch_wait(delay_s * 1000u);
+	if (delay_s) {
+		touch_wait(delay_s * 1000u);
+	}
+
+	vm_offset_t v50_se = ml_io_map(V50_SE_PA, 0x4000);
+	vm_offset_t v50_gpio = ml_io_map(V50_TLMM_PA, 0x100000);
+	if (v50_se && v50_gpio) {
+		printf("SWEET TOUCH: detected LG V50 SM8150 QUP SE17 at 0x%08x, TLMM SOUTH at 0x%08x\n",
+		    V50_SE_PA, V50_TLMM_PA);
+		st.se = v50_se;
+		st.gpio = v50_gpio;
+
+		/* Hardware power & reset sequence from sm8150-flash-touch-synaptics-s3707.dtsi */
+		touch_gpio(59, 0, 0, 3, true, true);  /* VCL (1.8V) enable */
+		touch_gpio(152, 0, 0, 3, true, true); /* VDD (3.3V) enable */
+		touch_wait(10);
+		touch_gpio(54, 0, 0, 3, true, false); /* Reset active low */
+		touch_wait(15);
+		touch_gpio(54, 0, 0, 3, true, true);  /* Reset release */
+		touch_wait(120);                      /* Wait for Synaptics MCU boot */
+		touch_gpio(122, 0, 3, 3, false, false); /* IRQ input with pull-up */
+
+		/* Mux GPIO 55 & 56 to qup1_se2 (function 1) */
+		touch_gpio(55, 1, 0, 0, false, false);
+		touch_gpio(56, 1, 0, 0, false, false);
+
+		/* SE17 is already clocked and loaded with I2C firmware by ABL */
+		touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+		touch_wr(st.se, SE_IRQ_EN, SE_EVENTS);
+
+		printf("SWEET TOUCH: SE17 status=0x%08x fw=0x%08x\n",
+		    touch_rd(st.se, SE_STATUS), touch_rd(st.se, SE_FW));
+
+		uint8_t sw_addr = 0x20;
+		/* Select Page 0: write 0x00 to register 0xFF */
+		(void)touch_write(sw_addr, 0xff, 0x00);
+
+		/* Scan RMI4 PDT (0xE9 down to 0x0A, 6 bytes each) */
+		uint8_t f01_ctrl = 0, f01_data = 0;
+		uint8_t f12_query = 0, f12_ctrl = 0, f12_data = 0;
+		struct rmi_pdt_desc dsc;
+		for (uint8_t pdt = 0xe9; pdt >= 0x0a; pdt -= 6) {
+			int pe = touch_read(sw_addr, pdt, false, (uint8_t *)&dsc, sizeof(dsc));
+			if (pe || !dsc.fn_num) {
+				break;
+			}
+			printf("SWEET TOUCH: PDT 0x%02x: fn=0x%02x q=0x%02x c=0x%02x d=0x%02x\n",
+			    pdt, dsc.fn_num, dsc.query_base, dsc.ctrl_base, dsc.data_base);
+			if (dsc.fn_num == 0x01) {
+				f01_ctrl = dsc.ctrl_base;
+				f01_data = dsc.data_base;
+			} else if (dsc.fn_num == 0x12) {
+				f12_query = dsc.query_base;
+				f12_ctrl = dsc.ctrl_base;
+				f12_data = dsc.data_base;
+			}
+		}
+
+		/* If F01 found, check status and set configured */
+		if (f01_ctrl || f01_data) {
+			uint8_t dev_stat = 0;
+			(void)touch_read(sw_addr, f01_data, false, &dev_stat, 1);
+			printf("SWEET TOUCH: F01 dev_status=0x%02x\n", dev_stat);
+			if (dev_stat == 0x81 || dev_stat != 0x00) {
+				(void)touch_write(sw_addr, f01_ctrl, 0x80); /* Set Configured */
+				touch_wait(10);
+				(void)touch_read(sw_addr, f01_data, false, &dev_stat, 1);
+				printf("SWEET TOUCH: F01 after configure dev_status=0x%02x\n", dev_stat);
+			}
+		}
+
+		/* Determine finger data register offset */
+		uint8_t finger_data_reg = f12_data ? (f12_data + 1) : 0x03;
+		if (f12_query) {
+			uint8_t q7 = 0;
+			int qe = touch_read(sw_addr, f12_query + 7, false, &q7, 1);
+			if (!qe && q7 > 0 && q7 <= 16) {
+				uint8_t q8[16] = {0};
+				(void)touch_read(sw_addr, f12_query + 8, false, q8, q7);
+				uint8_t offset = 0;
+				for (int i = 0; i < (q7 - 1) * 8; i++) {
+					if (q8[(i / 8) + 1] & (1 << (i % 8))) {
+						if (i == 1) {
+							finger_data_reg = f12_data + offset;
+							break;
+						}
+						offset++;
+					}
+				}
+			}
+		}
+		printf("SWEET TOUCH: S3707 F12 data_base=0x%02x finger_data_reg=0x%02x\n",
+		    f12_data, finger_data_reg);
+
+		/* Main touch read loop */
+		while (!st.dead) {
+			struct s3707_touch_data f[10];
+			int err = touch_read(sw_addr, finger_data_reg, false, (uint8_t *)f, sizeof(f));
+			if (!err) {
+				uint32_t mask = 0;
+				int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+				for (unsigned i = 0; i < 10; ++i) {
+					if (f[i].type == 1) { /* finger down */
+						mask |= (1u << i);
+						x[i] = (int)(f[i].x_lsb | ((unsigned)f[i].x_msb << 8));
+						y[i] = (int)(f[i].y_lsb | ((unsigned)f[i].y_msb << 8));
+					}
+				}
+				touch_report(mask, x, y);
+			} else {
+				delay(2000);
+			}
+			touch_wait(10);
+		}
+		touch_report(0, st.x, st.y);
+		goto out;
+	}
+
 	printf("SWEET TOUCH: mapping GCC/TLMM/SE7\n");
 	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
 	st.gpio = ml_io_map(TOUCH_NORTH_PA, 0x5b000);
